# ============================================================
# Eddy calibration reset test
#
# Requires the gcode_shell_command Klipper extension.
#
# Current Ender3Pro test path:
#   __EDDY_CLEAR_SCRIPT__
#
# This reset intentionally clears only Eddy calibration values written
# into Klipper's SAVE_CONFIG block. It does NOT remove probe offsets,
# zero_reference_position, bed_mesh settings, MCU connection settings,
# or other user configuration.
# ============================================================

[gcode_shell_command eddy_clear_calibration]
command: /usr/bin/python3 __EDDY_CLEAR_SCRIPT__
timeout: 10.
verbose: True


[gcode_macro EDDY_CLEAR_CALIBRATION]
description: Clear saved Eddy calibration data and restart into an uncalibrated state
gcode:
    {% set ns = namespace(probe="", count=0) %}

    # Automatically locate the configured native Eddy probe.
    {% for section in printer.configfile.settings %}
        {% if section.split()[0] == "probe_eddy_current" %}
            {% set ns.probe = section.split()[-1] %}
            {% set ns.count = ns.count + 1 %}
        {% endif %}
    {% endfor %}

    {% if ns.probe == "" %}
        {action_raise_error(
            "No [probe_eddy_current <name>] configuration was found."
        )}
    {% elif ns.count > 1 %}
        {action_raise_error(
            "Multiple Eddy probes detected. EDDY_CLEAR_CALIBRATION currently supports one configured Eddy probe."
        )}
    {% endif %}

    # Do not reset while a print is active or paused.
    {% if "print_stats" in printer
          and printer.print_stats.state|lower in ["printing", "paused"] %}
        {action_raise_error(
            "Eddy calibration cannot be cleared while a print is active or paused."
        )}
    {% endif %}

    # Do not throw away unrelated SAVE_CONFIG changes.
    {% set pending = printer.configfile.save_config_pending_items %}
    {% if pending|length > 0 %}
        {action_raise_error(
            "SAVE_CONFIG changes are currently pending. Save them or restart/discard them before clearing Eddy calibration."
        )}
    {% endif %}

    {% if printer.manual_probe.is_active %}
        {action_raise_error(
            "A manual probe operation is active. Finish or abort it before clearing Eddy calibration."
        )}
    {% endif %}

    RESPOND TYPE=command MSG="action:prompt_begin Clear Eddy Calibration"
    RESPOND TYPE=command MSG="action:prompt_text This will remove the saved calibration results for Eddy probe '{ns.probe}'."
    RESPOND TYPE=command MSG="action:prompt_text It clears LDC drive current, main Eddy calibration, Tap threshold/offset, and thermal compensation data."
    RESPOND TYPE=command MSG="action:prompt_text Probe offsets, zero_reference_position, bed mesh settings, and MCU configuration are preserved."
    RESPOND TYPE=command MSG="action:prompt_text A backup of printer.cfg will be created and Klipper will restart."
    RESPOND TYPE=command MSG="action:prompt_button Clear Calibration|_EDDY_CLEAR_CALIBRATION_CONFIRM|error"
    RESPOND TYPE=command MSG="action:prompt_footer_button Cancel|_EDDY_CLEAR_CALIBRATION_CANCEL|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"


[gcode_macro _EDDY_CLEAR_CALIBRATION_CONFIRM]
gcode:
    {% set ns = namespace(probe="", count=0) %}

    {% for section in printer.configfile.settings %}
        {% if section.split()[0] == "probe_eddy_current" %}
            {% set ns.probe = section.split()[-1] %}
            {% set ns.count = ns.count + 1 %}
        {% endif %}
    {% endfor %}

    {% if ns.probe == "" or ns.count != 1 %}
        {action_raise_error(
            "Unable to uniquely identify the Eddy probe."
        )}
    {% endif %}

    # Recheck pending SAVE_CONFIG data at confirmation time.
    {% set pending = printer.configfile.save_config_pending_items %}
    {% if pending|length > 0 %}
        {action_raise_error(
            "SAVE_CONFIG changes became pending. Save or restart/discard them before clearing Eddy calibration."
        )}
    {% endif %}

    RESPOND TYPE=command MSG="action:prompt_end"

    # Stop/reset any persisted Wizard continuation state.
    UPDATE_DELAYED_GCODE ID=_EDDY_SETUP_WATCH DURATION=0
    UPDATE_DELAYED_GCODE ID=_EDDY_SETUP_LDC_POSITION_WATCH DURATION=0
    SET_GCODE_VARIABLE MACRO=_EDDY_SETUP_STATE VARIABLE=step VALUE=0

    SAVE_VARIABLE VARIABLE=eddy_setup_active VALUE=0
    SAVE_VARIABLE VARIABLE=eddy_setup_target VALUE=0
    SAVE_VARIABLE VARIABLE=eddy_setup_probe VALUE='""'

    RESPOND TYPE=echo MSG="Clearing saved Eddy calibration data for probe '{ns.probe}'..."

    RUN_SHELL_COMMAND CMD=eddy_clear_calibration PARAMS="--probe {ns.probe}"

    RESPOND TYPE=echo MSG="Eddy calibration data cleared. Restarting Klipper..."

    RESTART


[gcode_macro _EDDY_CLEAR_CALIBRATION_CANCEL]
gcode:
    RESPOND TYPE=command MSG="action:prompt_end"
    RESPOND TYPE=echo MSG="Eddy calibration reset cancelled."
